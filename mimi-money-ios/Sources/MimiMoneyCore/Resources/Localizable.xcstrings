      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对房租、宽带、月薪、订阅会员等固定周期收支。启用计划后，可在卡片上点「立即入账」手动执行；到期自动入账将在后续版本接入。"
          }
        },
